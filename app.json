{
  "expo": {
    "name": "Painel 208",
    "slug": "painel-208",
    "version": "1.0.0",
    "platforms": ["android"],
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "android": {
      "package": "br.com.movcode.painel208",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-image",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Painel 208 usa o GPS para mostrar a velocidade e os dados da viagem."
        }
      ],
      [
        "expo-status-bar",
        {
          "hidden": true,
          "style": "light"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "hidden": true,
          "enforceContrast": false
        }
      ],
      [
        "./plugins/withCarLauncher",
        {
          "asHomeLauncher": false,
          "sensorLandscape": true,
          "apps": [
            { "label": "Waze", "package": "com.waze" },
            { "label": "Maps", "package": "com.google.android.apps.maps" },
            { "label": "Spotify", "package": "com.spotify.music" },
            { "label": "YT Music", "package": "com.google.android.apps.youtube.music" },
            { "label": "Deezer", "package": "deezer.android.app" },
            { "label": "WhatsApp", "package": "com.whatsapp" },
            { "label": "Telefone", "package": "com.samsung.android.dialer" }
          ]
        }
      ]
    ]
  }
}
