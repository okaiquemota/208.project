{
  "expo": {
    "name": "Painel 208",
    "slug": "painel-208",
    "version": "2.4.0",
    "platforms": ["android"],
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "android": {
      "package": "br.com.movcode.painel208",
      "versionCode": 9,
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-image",
      "expo-sqlite",
      ["./plugins/withLocalMaven", { "paths": ["modules/media-keys/android/maven"] }],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Inter",
                "fontDefinitions": [
                  { "path": "./node_modules/@expo-google-fonts/inter/300Light/Inter_300Light.ttf", "weight": 300 },
                  { "path": "./node_modules/@expo-google-fonts/inter/400Regular/Inter_400Regular.ttf", "weight": 400 },
                  { "path": "./node_modules/@expo-google-fonts/inter/500Medium/Inter_500Medium.ttf", "weight": 500 },
                  { "path": "./node_modules/@expo-google-fonts/inter/600SemiBold/Inter_600SemiBold.ttf", "weight": 600 },
                  { "path": "./node_modules/@expo-google-fonts/inter/700Bold/Inter_700Bold.ttf", "weight": 700 },
                  { "path": "./node_modules/@expo-google-fonts/inter/800ExtraBold/Inter_800ExtraBold.ttf", "weight": 800 }
                ]
              }
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Painel 208 usa o GPS para mostrar a velocidade e os dados da viagem."
        }
      ],
      [
        "expo-status-bar",
        {
          "hidden": true,
          "style": "light"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "hidden": true,
          "enforceContrast": false
        }
      ],
      [
        "./plugins/withCarLauncher",
        {
          "asHomeLauncher": false,
          "sensorLandscape": true,
          "apps": [
            { "label": "Waze", "package": "com.waze", "tipo": "navegacao" },
            { "label": "Maps", "package": "com.google.android.apps.maps", "tipo": "navegacao" },
            { "label": "Spotify", "package": "com.spotify.music", "tipo": "musica" },
            { "label": "YT Music", "package": "com.google.android.apps.youtube.music", "tipo": "musica" },
            { "label": "Deezer", "package": "deezer.android.app", "tipo": "musica" },
            { "label": "WhatsApp", "package": "com.whatsapp", "tipo": "comunicacao" },
            { "label": "Telefone", "package": "com.samsung.android.dialer", "tipo": "comunicacao" }
          ]
        }
      ]
    ]
  }
}
